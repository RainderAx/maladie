{
	"tasks": [
		{
			"label": "Build C++ project",
			"type": "shell",
			"command": "make",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"label": "Run C++ project",
			"type": "shell",
			"command": "make run",
			"isBackground": false,
			"problemMatcher": [
				"$gcc"
			],
			"group": "build"
		}
	],
	"version": "2.0.0"
}